# .env
DATABASE_URL=sqlite+aiosqlite:///./data/support_tickets.db

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Timeouts (critical for laptop performance)
OLLAMA_TIMEOUT_CONNECT=10
OLLAMA_TIMEOUT_READ=120
OLLAMA_TIMEOUT_WRITE=30

# Retry settings
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF=2.0
OLLAMA_RETRY_MAX_DELAY=30.0

# Generation options for faster responses
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_TOKENS=256

# Optional: Enable mock mode for testing without LLM
# LLM_MOCK_ENABLED=true
# LLM_MOCK_RESPONSE="Mock AI response for testing."

# App settings
LOG_LEVEL=INFO
TICKET_PRIORITY_THRESHOLD=0.65
ESCALATION_CONFIDENCE_THRESHOLD=0.55